FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/server:/app/runner:/app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 guard \
    && mkdir /app/.local && chown guard:guard /app/.local
COPY server ./server
COPY runner ./runner
COPY examples ./examples
COPY scripts ./scripts
COPY infra/starter.workflow.yml ./infra/starter.workflow.yml
USER guard
