# Examples only. Generate private local values with python scripts/prepare_env.py.
CI_GUARD_DEMO_MODE=false
CI_GUARD_DATABASE_PATH=.local/ci-guard.sqlite3
# CI_GUARD_TOKEN=<runner-token>
# CI_GUARD_ADMIN_TOKEN=<administrator-token>
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# FLAGSMITH_ENVIRONMENT_KEY=<environment-key>
# FLAGSMITH_ENVIRONMENT_ID=<environment-key-for-management-api>
# FLAGSMITH_ADMIN_API_KEY=<master-api-key>
FLAGSMITH_DASHBOARD_URL=http://localhost:8000

# GitHub App: enable Device Flow and install on selected repositories.
# Public app identifiers; a private key/client secret is not needed for this flow.
CI_GUARD_GITHUB_CLIENT_ID=
CI_GUARD_GITHUB_APP_SLUG=
# Generated once by scripts/prepare_env.py; keep outside the database/backups.
# CI_GUARD_GITHUB_ENCRYPTION_KEY=<private-fernet-key>
# Optional explicitly configured server token; no ambient GH_TOKEN is imported.
# CI_GUARD_GITHUB_TOKEN=<fine-grained-github-token>
